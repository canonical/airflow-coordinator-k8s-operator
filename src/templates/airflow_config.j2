[core]
executor = LocalExecutor
load_examples = False
fernet_key = {{ core__fernet_key }}

[database]
sql_alchemy_conn = {{ database__sql_alchemy_conn }}

[api]
base_url = {{ api__base_url }}
port = {{ api__port }}
secret_key = {{ api__secret_key }}

[api_auth]
jwt_secret = {{ api_auth__jwt_secret }}
